# EchoMind Airline MVP 运行配置模板
# 复制为 .env 后再修改：Copy-Item .env.example .env
# .env 已加入 .gitignore；不要把真实 API Key 提交到 Git。

# =============================================================================
# 1. 大模型
# =============================================================================
# 面试真实链路使用 openai_compatible；离线测试会在代码中显式覆盖为 mock。
AIRLINE_MVP_LLM_BACKEND=openai_compatible
AIRLINE_MVP_LLM_BASE_URL=
AIRLINE_MVP_LLM_API_KEY=
AIRLINE_MVP_LLM_MODEL=
AIRLINE_MVP_LLM_TEMPERATURE=0
AIRLINE_MVP_LLM_TIMEOUT_SECONDS=60
AIRLINE_MVP_LLM_MAX_RETRIES=2

# =============================================================================
# 2. Docker Compose PostgreSQL（仅供 compose.yaml 使用）
# =============================================================================
# 不填写也可以，Compose 会使用右侧对应的默认值。
# 如果修改账号、密码或端口，下面的 AIRLINE_MVP_DATABASE_URL 必须同步修改。
AIRLINE_MVP_POSTGRES_DB=airline_mvp
AIRLINE_MVP_POSTGRES_USER=airline_mvp
AIRLINE_MVP_POSTGRES_PASSWORD=airline_mvp_dev
AIRLINE_MVP_POSTGRES_PORT=5432
AIRLINE_MVP_API_HOST_PORT=8000

# =============================================================================
# 3. 应用业务数据库（Case、Evidence、ToolCall、Trace、Handoff）
# =============================================================================
# Docker 外的本机进程使用 127.0.0.1；Compose 会覆盖为主机名 postgres。
AIRLINE_MVP_DATABASE_BACKEND=postgres
AIRLINE_MVP_DATABASE_URL=postgresql://airline_mvp:airline_mvp_dev@127.0.0.1:5432/airline_mvp
AIRLINE_MVP_DATABASE_POOL_SIZE=5

# =============================================================================
# 4. LangGraph Checkpoint
# =============================================================================
# 面试运行档固定 postgres；URL 为空时复用 AIRLINE_MVP_DATABASE_URL。
AIRLINE_MVP_CHECKPOINT_BACKEND=postgres
AIRLINE_MVP_CHECKPOINT_DATABASE_URL=

# =============================================================================
# 5. RAG 与 Embedding
# =============================================================================
# PostgreSQL 同时保存来源、原文、FTS 索引、pgvector 向量和导入审计。
AIRLINE_MVP_KNOWLEDGE_BACKEND=postgres

# local_fastembed：真实本地 ONNX 模型；mock 仅用于单元测试。
# 也可以切换 openai_compatible 并填写下面的远程 Embedding 配置。
AIRLINE_MVP_EMBEDDING_BACKEND=local_fastembed
AIRLINE_MVP_EMBEDDING_BASE_URL=
AIRLINE_MVP_EMBEDDING_API_KEY=
AIRLINE_MVP_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AIRLINE_MVP_EMBEDDING_DIMENSIONS=512

# =============================================================================
# 6. 可选目录覆盖
# =============================================================================
AIRLINE_MVP_RUNTIME_DIR=
AIRLINE_MVP_DATA_DIR=

# 航司航班、PNR、客票、退款和支付 API 本轮固定使用 data/fixtures，
# 因此没有 AIRLINE_API_KEY；这可以避免把演示工程误接到真实旅客数据。
