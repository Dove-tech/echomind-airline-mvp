# EchoMind Airline MVP 运行配置模板
# 复制为 .env 后再修改：Copy-Item .env.example .env
# .env 已加入 .gitignore；不要把真实 API Key 提交到 Git。

# =============================================================================
# 1. 大模型
# =============================================================================
# mock：默认确定性实现，不访问网络
# openai_compatible：实际调用下面填写的 Chat API
AIRLINE_MVP_LLM_BACKEND=mock
AIRLINE_MVP_LLM_BASE_URL=
AIRLINE_MVP_LLM_API_KEY=
AIRLINE_MVP_LLM_MODEL=
AIRLINE_MVP_LLM_TEMPERATURE=0
AIRLINE_MVP_LLM_TIMEOUT_SECONDS=60
AIRLINE_MVP_LLM_MAX_RETRIES=2

# =============================================================================
# 2. 应用业务数据库（Case、Evidence、ToolCall、Trace、Handoff）
# =============================================================================
# sqlite：默认使用 .runtime/airline_mvp.sqlite3，无需启动数据库服务
# postgres：实际连接下面填写的 PostgreSQL URL
AIRLINE_MVP_DATABASE_BACKEND=sqlite
AIRLINE_MVP_DATABASE_URL=
AIRLINE_MVP_DATABASE_POOL_SIZE=5

# =============================================================================
# 3. LangGraph Checkpoint
# =============================================================================
# 可选 memory / sqlite / postgres。
# postgres URL 为空时会复用 AIRLINE_MVP_DATABASE_URL。
AIRLINE_MVP_CHECKPOINT_BACKEND=sqlite
AIRLINE_MVP_CHECKPOINT_DATABASE_URL=

# =============================================================================
# 4. RAG 与 Embedding
# =============================================================================
# local：内存向量检索；chroma：真实的本地持久化 Chroma 向量库
AIRLINE_MVP_KNOWLEDGE_BACKEND=chroma

# mock：本地 Hash Embedding；openai_compatible：实际调用 Embedding API
AIRLINE_MVP_EMBEDDING_BACKEND=mock
AIRLINE_MVP_EMBEDDING_BASE_URL=
AIRLINE_MVP_EMBEDDING_API_KEY=
AIRLINE_MVP_EMBEDDING_MODEL=
# 某些模型支持显式指定维数；不需要时保持空值。
AIRLINE_MVP_EMBEDDING_DIMENSIONS=

# =============================================================================
# 5. 可选目录覆盖
# =============================================================================
AIRLINE_MVP_RUNTIME_DIR=
AIRLINE_MVP_DATA_DIR=

# 航司航班、PNR、客票、退款和支付 API 本轮固定使用 data/fixtures，
# 因此没有 AIRLINE_API_KEY；这可以避免把演示工程误接到真实旅客数据。
